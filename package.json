{
  "name": "xiaoxiaoyunclient",
  "productName": "校校云客户端",
  "version": "1.0.0",
  "description": "校校云客户端 —— 基于 Electron 的原网页封装桌面端，带标题栏、刷新与账号自动登录。",
  "license": "MIT",
  "main": "src/main/main.js",
  "author": "yueEnjoylife123456721",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yueEnjoylife123456721/xiaoxiaoyunclient.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.xiaoxiaoyun.client",
    "productName": "校校云客户端",
    "artifactName": "xiaoxiaoyunclient-v${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "校校云客户端",
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
